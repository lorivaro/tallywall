# Copy to .env and fill in. Never commit .env.

# --- Turff -------------------------------------------------------------------
# real = talk to web.turff.nl, fake = in-memory demo house (UI work, no credentials needed)
TURFF_MODE=real
# Dedicated service account; must be beheerder (manager) of the house.
TURFF_EMAIL=
TURFF_PASSWORD=
# House UID, e.g. from the URL on web.turff.nl.
TURFF_HOUSE_UID=

# --- Reverse proxy -----------------------------------------------------------
# Peers whose X-Forwarded-For header is trusted (comma-separated IPs or CIDRs).
# Set to the subnet of the Caddy network:
#   docker network inspect caddy -f '{{(index .IPAM.Config 0).Subnet}}'
TRUSTED_PROXIES=172.18.0.0/16

# --- Docker compose ----------------------------------------------------------
# Name of the external network the Caddy container is on (default: caddy).
#CADDY_NETWORK=caddy
# Host user that owns ./data (default 1000:1000).
#UID=1000
#GID=1000

# --- Rarely needed (the image sets sensible defaults) ------------------------
#DB_PATH=/data/tallywall.db
#AVATARS_DIR=/avatars
#PORT=8000
